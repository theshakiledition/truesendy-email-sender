# Production Multi-Stage Dockerfile for Next.js Web Frontend
FROM node:20-alpine AS base

WORKDIR /app

# Dependencies Stage
FROM base AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci || npm install

# Build Stage
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build || true

# Runner Stage
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Copy built artifacts
COPY --from=builder /app ./

EXPOSE 3000

CMD ["npm", "start"]
