# Production Multi-Stage Dockerfile for Next.js Web Frontend
FROM node:20-alpine AS base

WORKDIR /app

# Dependencies Stage
FROM base AS deps
WORKDIR /app
COPY package*.json ./
COPY prisma ./prisma/
RUN npm install
RUN npx prisma generate

# Build Stage
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate
RUN npm run build

# Runner Stage
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Copy built application and modules
COPY --from=builder /app ./

EXPOSE 3000

CMD ["npx", "next", "start", "-p", "3000"]
