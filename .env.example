# ==============================================================================
# Environment Configuration for Cold Email Outreach SaaS (TrueSendy)
# ==============================================================================

NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretDatabasePassword123!
POSTGRES_DB=truesendy
DATABASE_URL=postgresql://postgres:SuperSecretDatabasePassword123!@postgres:5432/truesendy?schema=public

# Redis Cache & Queues
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption (AES-256-GCM 32-byte secret hex or arbitrary string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TRACKING_SECRET=generate-a-secure-random-hmac-secret-string

# Domains & Custom Tracking CNAME
APP_PRIMARY_DOMAIN=truesendy.com
TRACKING_CNAME_TARGET=track.truesendy.com

# AI Intent Categorization (OpenAI or Gemini)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Deliverability Safety & Emergency Brake
EMERGENCY_BRAKE_MIN_SENT=50
EMERGENCY_BRAKE_MAX_BOUNCE_RATE=0.08
INBOX_MONITOR_INTERVAL_MS=60000

# System Alert Emailer
SYSTEM_SMTP_HOST=smtp.sendgrid.net
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=apikey
SYSTEM_SMTP_PASS=your-smtp-api-key
SYSTEM_ALERT_FROM="TrueSendy Security Guard" <alerts@truesendy.com>

# Outbound Proxies (Webshare)
WEBSHARE_DOWNLOAD_URL=https://proxy.webshare.io/api/v2/proxy/list/download/YOUR_TOKEN/-/any/username/direct/-/
